{
  "manifest_version": 3,
  "name": "Watchlist Ciné — Suivi auto",
  "version": "0.1.0",
  "description": "Marque automatiquement ta progression dans Watchlist Ciné Premium pendant que tu regardes sur Netflix.",
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" },
  "action": { "default_popup": "options.html", "default_icon": "icons/icon.png" },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://batfulcvvquffgfeppcx.supabase.co/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/watch/*"],
      "js": ["content/netflix.js"],
      "run_at": "document_idle"
    }
  ]
}
