{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Cinepisode",
  "default_locale": "en",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://cinepisode.com",
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" },
  "action": { "default_popup": "options.html", "default_icon": "icons/icon.png", "default_title": "__MSG_extName__" },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://batfulcvvquffgfeppcx.supabase.co/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/watch/*"],
      "js": ["content/netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/watch/*"],
      "js": ["content/netflix-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.primevideo.com/*", "https://www.amazon.com/gp/video/*"],
      "js": ["content/_common-main.js", "content/primevideo-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["content/_common-main.js", "content/disneyplus-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://play.max.com/*", "https://play.hbomax.com/*"],
      "js": ["content/_common-main.js", "content/max-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": ["content/_common-main.js", "content/crunchyroll-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
