{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinepisode",
  "version": "1.0.0",
  "identifier": "com.watchlistcine.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cinepisode",
        "url": "https://cinepisode.com",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzNzAzQUNGREE3QjJCQUEKUldTcUszdmF6enB3c3lJN3dqSTBYYWNGUXJpSXY3S3BQRnFYT1JNM2lCTkpOT05HS2QzR1Bwd2cK",
      "endpoints": [
        "https://cinepisode.com/api/releases?f=manifest"
      ]
    }
  }
}
